;=========================================================================================
; Часовой
;=========================================================================================
[logic@agr_factory_suspects_guard_1]
active = walker1@agr_factory_suspects_guard_1

[walker1@agr_factory_suspects_guard_1]
path_walk = guard_walk
path_look = guard_look
on_actor_dist_le = 5 | {-agr_eavesdropping_backoff} remark1@agr_factory_suspects_guard_1
meet = no_meet

[remark1@agr_factory_suspects_guard_1]
anim = threat
target = actor
snd = factory_suspect_backoff
on_signal = sound_end | walker1@agr_factory_suspects_guard_1 %+agr_eavesdropping_backoff%
meet = no_meet

