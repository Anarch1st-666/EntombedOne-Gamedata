;------------------ Common sections -----------------------
[hit@agr_nii_quest_person]
damage_ignore_cond = {-agr_revenge_start}

[meet@agr_nii_patrol]
meet_dialog = agr_nii_base

[meet@agr_nii_north]
meet_dialog = agr_nii_north

[meet@agr_nii_west]
meet_dialog = agr_nii_west

[meet@agr_nii_south]
meet_dialog = agr_nii_south

[meet@agr_nii_east]
meet_dialog = agr_nii_east


;------------------ Квестовики -----------------------
[logic@agr_nii_grechkin]
active = walker1@agr_nii_grechkin
on_hit = hit@agr_nii_quest_person

[walker1@agr_nii_grechkin]
path_walk = grechkin_walk
path_look = grechkin_look
meet = meet@agr_nii_grechkin

[meet@agr_nii_grechkin]
meet_state = 5|wait
meet_state_wpn = 5|wait
victim = 5|actor
victim_wpn = 5|actor
use = true
use_wpn = true
meet_dialog = {+agr_seek_duty_support_start -agr_seek_duty_support_talk_to_grechkin} grechkin_crashcopter


[logic@agr_nii_trader]
active = walker1@agr_nii_trader
on_hit = hit@agr_nii_quest_person
trade = misc\trade_dolg.ltx
inv_max_weight = 10000

[walker1@agr_nii_trader]
path_walk = barman_walk
path_look = barman_look
def_state_standing = barman_wait_free
def_state_moving1 = barman_walk_free
def_state_moving2 = barman_walk_free
def_state_moving3 = barman_walk_free
combat_ignore_cond = always
meet = meet@agr_nii_trader

[meet@agr_nii_trader]
meet_state = 3|barman_talk_free
meet_state_wpn = 3|barman_talk_free
victim = 3|actor
victim_wpn = 3|actor
use = true
use_wpn = true


[logic@agr_silent]
active = walker@agr_silent_tired
on_hit = hit@agr_nii_quest_person

[walker@agr_silent_tired]
path_walk = bar_silent_walk
path_look = bar_silent_look
def_state_standing = bar_head
danger = danger_ignore
meet = no_meet
danger = danger_ignore
on_actor_dist_le_nvis = 5 | {+agr_decoder_repair_find_technician -agr_decoder_repair_talk_to_silent} walker@agr_silent_talk

[walker@agr_silent_talk]
path_walk = bar_silent_walk
path_look = bar_silent_look
def_state_standing = bar_fas
danger = danger_ignore
meet = meet@agr_silent
on_info = {+agr_decoder_repair_talk_to_silent} walker@agr_silent_tired
on_info2 = {+agr_decoder_repair_drinking_vodka} remark@agr_silent_drink_vodka %=play_snd(interface\inv_vodka:3)%

[remark@agr_silent_drink_vodka]
anim = drink_vodka
target = actor
danger = danger_ignore
meet = meet@agr_silent
on_timer = 5000 | remark@agr_silent_stop_vodka %=actor_gets_drunk%

[remark@agr_silent_stop_vodka]
anim = drink_vodka_out
target = actor
danger = danger_ignore
meet = meet@agr_silent
on_signal = anim_end | walker@agr_silent_talk %-agr_decoder_repair_drinking_vodka =show_saboteur_dialog_window%

[meet@agr_silent]
meet_state = nil
meet_state_wpn = nil
victim = nil
victim_wpn = nil
use = true
use_wpn = true
allow_break = false
meet_dialog = {+agr_decoder_repair_find_technician -agr_decoder_repair_talk_to_silent} silent_drinking


[logic@agr_freon]
active = walker1@agr_freon_sit
on_hit = hit@agr_nii_quest_person

[walker1@agr_freon_sit]
path_walk = freon_sit_walk
path_look = freon_sit_look
def_state_moving1 = walk
def_state_moving2 = walk
meet = meet@agr_freon_sit
on_info = {+agr_decoder_repair_technician_work} walker1@agr_freon_work

[meet@agr_freon_sit]
meet_state = nil
meet_state_wpn = nil
victim = nil
victim_wpn = nil
use = true
use_wpn = true

[walker1@agr_freon_work]
path_walk = freon_work_walk
path_look = freon_work_look
def_state_standing = choose
def_state_moving1 = walk
def_state_moving2 = walk
meet = meet@agr_freon_work
on_info = {-agr_decoder_repair_technician_work} walker1@agr_freon_sit

[meet@agr_freon_work]
meet_state = 5|wait_trade
meet_state_wpn = 5|wait_trade
victim = 5|actor
victim_wpn = 5|actor
use = true
use_wpn = true


