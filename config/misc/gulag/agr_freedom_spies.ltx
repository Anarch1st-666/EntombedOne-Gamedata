path_look = bodyguard_1_look
show_spot = false
danger = danger@agr_freedom_spies
combat_ignore_cond = {=fighting_actor -agr_freedom_spies_can_attack_actor}, {=check_fighting(110) -agr_freedom_spies_can_attack_actor}
meet = meet@agr_freedom_spies_guard
on_info = {+agr_freedom_spies_can_attack_prisoner -agr_prisoner_scout_dead} remark@agr_freedom_spies_bodyguard_1

[remark@agr_freedom_spies_bodyguard_1]
target = 110
anim = hide_fire
danger = danger@agr_freedom_spies
combat_ignore_cond = {=fighting_actor -agr_freedom_spies_can_attack_actor}, {=check_fighting(110) -agr_freedom_spies_can_attack_actor}
meet = no_meet
on_info = {+agr_prisoner_scout_dead} walker1@agr_freedom_spies_bodyguard_1


