;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

[danger@agr_freedom_spies]
ignore_distance = 0

[combat_ignore@agr_freedom_spies]

[death@agr_freedom_spies]
on_info = %+agr_freedom_spies_can_attack_actor%

[hit@agr_freedom_spies]
on_info = {=hit_by_actor} %+agr_freedom_spies_can_attack_actor%

[meet@agr_freedom_spies_guard]
meet_state = 5 | threat
meet_state_wpn = 15 | backoff@threat_weap
victim = 5 | actor
victim_wpn = 15 | actor
use	= false
use_wpn = false

[meet@agr_freedom_spies_no_meet]
meet_state = nil
meet_state_wpn = nil
victim = nil
victim_wpn = nil
use	= false
use_wpn = false


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

[logic@agr_freedom_spies_leader]
active = walker1@agr_freedom_spies_leader
on_hit = hit@agr_freedom_spies
on_death = death@agr_freedom_spies
combat_ignore = combat_ignore@agr_freedom_spies

[walker1@agr_freedom_spies_leader]
path_walk = leader_walk
path_look = leader_look
show_spot = false
def_state_standing = sit_cop
danger = danger@agr_freedom_spies
combat_ignore_cond = {=fighting_actor -agr_freedom_spies_can_attack_actor}, {=check_fighting(110) -agr_freedom_spies_can_attack_actor}
meet = meet@agr_freedom_spies_leader

[meet@agr_freedom_spies_leader]
meet_state = nil
meet_state_wpn = nil
victim = nil
victim_wpn = nil
use = true
use_wpn = true
meet_dialog = {-agr_prisoner_start} saboteur_dealing, {-agr_prisoner_complete -agr_prisoner_fail} saboteur_giant


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

[logic@agr_freedom_spies_bodyguard_1]
active = walker1@agr_freedom_spies_bodyguard_1
on_hit = hit@agr_freedom_spies
on_death = death@agr_freedom_spies
combat_ignore = combat_ignore@agr_freedom_spies

[walker1@agr_freedom_spies_bodyguard_1]
