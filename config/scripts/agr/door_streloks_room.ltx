[logic]
active = ph_door@locked

[ph_door@locked]
locked = true
closed = true
snd_open_start = metal_small_locked
on_use = {=actor_has_item(catacombs_secret_room_key)} ph_door@close %=lost_item(catacombs_secret_room_key)%

[ph_door@close]
locked = false
closed = true
snd_open_start = metal_small_open
snd_close_start = metal_small_close_start
snd_close_stop = metal_small_close_stop
on_use = ph_door@open

[ph_door@open]
locked = false
closed = false
snd_open_start = metal_small_open
snd_close_start = metal_small_close_start
snd_close_stop = metal_small_close_stop
on_use = ph_door@close
