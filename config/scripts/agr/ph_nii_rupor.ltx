[hit]
on_info = %+agr_nii_rupor_off%

[logic]
active = ph_idle
on_hit = hit

[ph_idle]
on_info = {+agr_revenge_start} ph_sound@alarm
on_info2 = {+agr_nii_rupor_off} nil, {+agr_revenge_complete} nil

[ph_sound@alarm]
snd = siren
looped = true
on_info = {+agr_nii_rupor_off} nil, {+agr_revenge_complete} nil

