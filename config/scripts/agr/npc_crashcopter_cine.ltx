[logic]
active = walker@search
on_hit = hit
combat_ignore = combat_ignore

[hit]
ignore_damage_cond = always

[combat_ignore]


[walker@search]
path_walk			= agr_crashcopter_cine_walk
path_look			= agr_crashcopter_cine_look
on_signal			= arrived | remark1
combat_ignore_cond	= always
meet				= no_meet

[remark1]
anim				= guard_rac
snd					= crashcopter_actor
target				= agr_cine_crashcopter_look, 0
on_signal			= sound_end | remark2 %=play_snd_from_object(characters_voice\scenario\agroprom\crashcopter_cine_commander_1:1)%
combat_ignore_cond	= always
meet				= no_meet

[remark2]
anim 				= guard_rac
target				= agr_cine_crashcopter_look, 0
on_timer			= 4000 | remark3
combat_ignore_cond	= always
meet				= no_meet

[remark3]
anim				= guard_rac
snd					= crashcopter_actor
target				= agr_cine_crashcopter_look, 0
on_signal			= sound_end | remark4 %=play_snd_from_object(characters_voice\scenario\agroprom\crashcopter_cine_commander_2_00:1)%
combat_ignore_cond	= always
meet				= no_meet

[remark4]
anim 				= guard_rac
target				= agr_cine_crashcopter_look, 0
on_timer			= 15000 | remark5
combat_ignore_cond	= always
meet				= no_meet

[remark5]
anim				= guard_rac
snd					= crashcopter_actor
target				= agr_cine_crashcopter_look, 0
on_signal			= sound_end | walker@no_search %=run_postprocess(fade_in_out:7911)%
combat_ignore_cond	= always
meet				= no_meet

[walker@no_search]
path_walk			= agr_crashcopter_cine_walk
path_look			= agr_crashcopter_cine_look
def_state_standing	= guard
on_timer			= 2500 | %=release_object%
combat_ignore_cond	= always
meet				= no_meet