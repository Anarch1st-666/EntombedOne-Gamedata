[logic]
active = ph_door@closed

[ph_door@closed]
locked = false
closed = true
snd_open_start = metal_small_open
snd_close_start = metal_small_close_start
snd_close_stop = metal_small_close_stop
on_use = ph_door@open %+agr_gold_clocks_find_bandits +agr_gold_clocks_bandit_spawn%
on_info = {+agr_gold_clocks_clocks_got -agr_gold_clocks_controller_dead} ph_door@locked

[ph_door@open]
locked = false
closed = false
snd_open_start = metal_small_open
snd_close_start = metal_small_close_start
snd_close_stop = metal_small_close_stop
on_use = ph_door@closed %+agr_gold_clocks_find_bandits +agr_gold_clocks_bandit_spawn%
on_info = {+agr_gold_clocks_clocks_got -agr_gold_clocks_controller_dead} ph_door@locked

[ph_door@locked]
locked = true
closed = true
snd_open_start = metal_small_locked
on_info = {+agr_gold_clocks_controller_dead}  ph_door@closed