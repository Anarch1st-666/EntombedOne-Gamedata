[logic]
active = sr_idle

[sr_idle]
on_actor_inside = {+agr_explore_catacombs_location_all} sr_idle@play_0 %+agr_explore_catacombs_complete%

[sr_idle@play_0]
on_timer = 1000 | sr_idle@play_1 %=send_tip(need_electric_1)%

[sr_idle@play_1]
on_timer = 2000 | sr_idle@play_2 %=send_tip(need_electric_2)%

[sr_idle@play_2]
on_timer = 2000 | sr_idle@play_3 %=send_tip(need_electric_3)%

[sr_idle@play_3]
on_timer = 7000 | sr_idle@play_4 %=send_tip(need_electric_4)%

[sr_idle@play_4]
on_timer = 4000 | nil %+agr_decoder_repair_start =release_object%