--' "Долгаря в расход", игрок стоит ждёт
function hide_saboteur_dialog_window()
	level.disable_input()
	local dialog_wnd = level.main_input_receiver()
	if dialog_wnd ~= nil then
		dialog_wnd:Show(false)
	end
end

--'
function has_pda_saboteur()
	return db.actor:object("pda_saboteur") ~= nil
end

--'
function recieve_pda_saboteur_reward()
	dialogs.relocate_item_section(nil, "pda_saboteur", "out")
	dialogs.relocate_item_section(nil, "wpn_val", "in")
	dialogs.relocate_item_section(nil, "ammo_9x39_sp5", "in")
	dialogs.relocate_item_section(nil, "ammo_9x39_sp5", "in")
end

--' Награда свободовцев
function saboteur_reward()
	dialogs.relocate_item_section(nil, "ammo_m209", "in")
	dialogs.relocate_item_section(nil, "ammo_m209", "in")
	dialogs.relocate_item_section(nil, "ammo_m209", "in")
	dialogs.relocate_item_section(nil, "ammo_m209", "in")
	dialogs.relocate_item_section(nil, "ammo_m209", "in")
	dialogs.relocate_item_section(nil, "wpn_addon_grenade_launcher_m203", "in")
	dialogs.relocate_money(db.actor:get_talk_partner(), 8000, "in")
end

function make_freedom_enemy()
--	relation_registry.set_community_goodwill ("freedom", "actor", -1000)
	xr_effects.set_gulag_enemy_actor(db.actor, nil, {"agr_freedom_spies"})
end

--' Пригрозить оружием в диалоге
function unhide_weapon_in_dialog()
end

-- Есть части декодера
function has_decoder_parts()
	return xr_conditions.actor_has_items(db.actor, nil, {
		"catacombs_decoder_plate", 1,
		"catacombs_decoder_shell", 1,
	})
end

--' Отдаём технику части декодера
function give_decoder_parts()
	dialogs.relocate_item_section(nil, "catacombs_decoder_plate", "out")
	dialogs.relocate_item_section(nil, "catacombs_decoder_shell", "out")
end

--' Забираем декодер у техника
function got_decoder()
	dialogs.relocate_item_section(nil, "catacombs_decoder", "in")
end

function has_vodka_for_silent()
	return xr_conditions.actor_has_items(db.actor, nil, {"vodka", "2"})
end

function dont_has_vodka_for_silent()
	return not has_vodka_for_silent()
end

