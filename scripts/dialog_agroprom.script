--' Предателсьтво Гречкина
function grechkin_got_case()
	dialogs.relocate_item_section(nil, "crashcopter_case", "out")
end

function grechkin_kill_order()
	cmd("g_god on")
--	db.actor:invulnerable(true)
--	db.actor:set_character_community("zombied")
	xr_effects.set_gulag_enemy_actor(db.actor, nil, {"agr_betrayal"})
--	log3("invul[%s]", db.actor:invulnerable())
end

function disable_ui()
	db.actor:hide_weapon()
	level.disable_input()
	level.hide_indicators()
end

function grechkin_kills_actor()
	if db.actor:dont_has_info("agr_grechkin_kills_actor") then
		db.actor:give_info_portion("agr_grechkin_kills_actor")
		xr_effects.play_actor_death_effector()
	end
end

function enable_ui()
	level.show_indicators()
	level.enable_input()
	db.actor:restore_weapon()
end

function create_nii_main_door_key()
	local sim = alife()
	sim:create(sim:spawn_id(spawn_story_ids.nii_main_doors_key))
	sr_weather.get_weather_effector():set_music_volume(0.1)
end